#!/bin/sh
# Apply this repo's configs to the machine. Packages are separate:
# `brew bundle --file=Brewfile`.
set -eu

case "${1-}" in
  ""|--agents-only) ;;
  *) echo "Usage: ./export_current [--agents-only]" >&2; exit 2 ;;
esac
if [ "$#" -gt 1 ]; then
  echo "Usage: ./export_current [--agents-only]" >&2
  exit 2
fi

if [ "${1-}" != --agents-only ]; then

  dirs="ghostty nvim opencode tmux zsh starship lazygit btop git karabiner"

  for d in $dirs; do
    cp -rf "./$d" "$HOME/.config/"
  done

  cp -f ./zsh/.zshenv "$HOME/.zshenv"

  mkdir -p "$HOME/.local/bin"
  cp -f ./bin/* "$HOME/.local/bin/"
  for s in ./bin/*; do
    chmod +x "$HOME/.local/bin/$(basename "$s")"
  done

fi

# Shared sources come from personal-server via scripts/sync-agent-prompts.py.
# Append this machine's notes when generating the installed instructions.
mkdir -p "$HOME/.claude" "$HOME/.codex" "$HOME/.config/opencode"
{ cat ./agents/claude-global.md; echo; cat ./agents/models.md; echo; cat ./agents/workflow.md; echo; cat ./agents/yuggoth-agents.md; } > "$HOME/.claude/CLAUDE.md"
{ cat ./agents/codex-global.md; echo; cat ./agents/models.md; echo; cat ./agents/workflow.md; echo; cat ./agents/yuggoth-agents.md; } > "$HOME/.codex/AGENTS.md"
{ cat ./agents/opencode-global.md; echo; cat ./agents/models.md; echo; cat ./agents/workflow.md; echo; cat ./agents/yuggoth-agents.md; } > "$HOME/.config/opencode/AGENTS.md"

# References are loaded only for tasks that need their procedures.
mkdir -p "$HOME/.agents/references"
cp -f ./agents/references/*.md "$HOME/.agents/references/"

# Skills vendored in the repo so a fresh install has them. Claude Code reads
# ~/.claude/skills; codex and opencode both read ~/.agents/skills. Other
# entries in those dirs (installed with `npx skills add ...`) are left alone.
mkdir -p "$HOME/.claude/skills" "$HOME/.agents/skills"
cp -rf ./agents/skills/plan-html-workflow "$HOME/.claude/skills/"
cp -rf ./agents/skills/unslop "$HOME/.claude/skills/"
cp -rf ./agents/skills/unslop "$HOME/.agents/skills/"

# Hook scripts referenced by ~/.claude/settings.json. That file stays mutable
# (Claude Code writes to it at runtime), so the hooks block in it is set by
# hand (see README); only the scripts are repo-managed.
mkdir -p "$HOME/.claude/hooks"
cp -f ./agents/hooks/* "$HOME/.claude/hooks/"
for s in ./agents/hooks/*; do
  chmod +x "$HOME/.claude/hooks/$(basename "$s")"
done
