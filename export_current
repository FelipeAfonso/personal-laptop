#!/bin/sh
# Apply this repo's configs to the machine. Packages are separate:
# `brew bundle --file=Brewfile`.
set -eu

dirs="ghostty nvim opencode tmux zsh starship lazygit btop git karabiner"

for d in $dirs; do
  cp -rf "./$d" "$HOME/.config/"
done

cp -f ./zsh/.zshenv "$HOME/.zshenv"
cp -f ./aerospace/aerospace.toml "$HOME/.aerospace.toml"

# Frozen wallust palette so neopywal keeps miskatonic's colors
mkdir -p "$HOME/.cache/wallust"
cp -f ./nvim/colors_neopywal.vim "$HOME/.cache/wallust/colors_neopywal.vim"

mkdir -p "$HOME/.local/bin"
cp -f ./bin/* "$HOME/.local/bin/"
for s in ./bin/*; do
  chmod +x "$HOME/.local/bin/$(basename "$s")"
done
