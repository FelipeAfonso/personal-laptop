#!/bin/sh
# Apply this repo's configs to the machine.
set -eu

dirs="ghostty dunst hypr nvim opencode rofi tmux waybar wallust xkb zsh starship lazygit"

for d in $dirs; do
  cp -rf "./$d" "$HOME/.config/"
done

cp -f ./zsh/.zshenv "$HOME/.zshenv"

mkdir -p "$HOME/.local/bin"
cp -f ./bin/* "$HOME/.local/bin/"
chmod +x "$HOME/.local/bin/review" "$HOME/.local/bin/unreview"
