#!/bin/sh
# Pull the live configs from ~/.config into this repo. Run from the repo root.
set -eu

dirs="ghostty dunst hypr nvim opencode rofi tmux waybar wallust xkb zsh starship lazygit"

for d in $dirs; do
  rm -rf "./$d"
  cp -r "$HOME/.config/$d" ./
done

# Strip machine state that must never be committed
rm -f ./zsh/.zsh_history ./zsh/.zcompdump* ./dunst/notification.log
rm -rf ./tmux/plugins ./nvim/doc

mkdir -p ./bin
cp -f "$HOME/.local/bin/review" "$HOME/.local/bin/unreview" ./bin/
