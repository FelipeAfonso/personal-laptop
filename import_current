#!/bin/sh
# Pull the live state of miskatonic into this repo. Run from the repo root.
set -eu

dirs="ghostty dunst hypr nvim opencode rofi tmux waybar wallust xkb zsh starship lazygit btop MangoHud git gtk-3.0 gtk-4.0"
files="mimeapps.list user-dirs.dirs"
scripts="review unreview secrets-pull t3code t3code-hide-appimagekit-entry t3-vi"

for d in $dirs; do
  rm -rf "./$d"
  cp -r "$HOME/.config/$d" ./
done

for f in $files; do
  cp -f "$HOME/.config/$f" ./
done

# Until ~/.gitconfig moves to the XDG path, it is the authoritative git config
[ -f "$HOME/.gitconfig" ] && cp -f "$HOME/.gitconfig" ./git/config

# Strip machine state that must never be committed
rm -f ./zsh/.zsh_history ./zsh/.zcompdump* ./zsh/.secrets.env ./dunst/notification.log
rm -rf ./tmux/plugins ./nvim/doc ./opencode/node_modules

# Strip dead live leftovers so they never come back: pre-redux nvim (kickstart
# fork + its nested .git), hyprlock/hypridle (dropped on purpose), the old
# hyprland.conf (superseded by hyprland.lua), wofi-era rofi css, stray junk
rm -rf ./nvim/.git ./nvim/.github ./nvim/lua/custom ./nvim/lua/kickstart
rm -f ./nvim/lazy-lock.json ./nvim/LICENSE.md ./nvim/README.md ./nvim/.gitignore
rm -f ./hypr/hypr.conf ./hypr/hypridle.conf ./hypr/hyprlock.conf ./hypr/hyprlock-colors.conf
rm -f ./hypr/hyprland.conf ./hypr/hyprland.conf.default ./hypr/hyprland-colors.conf
rm -f ./hypr/record ./hypr/openwhispr-binds.conf ./wallust/templates/hyprlock-colors.conf
rm -f ./rofi/style.css ./ghostty/Untitled ./opencode/*.bak ./tmux/.DS_Store

mkdir -p ./bin
for s in $scripts; do
  cp -f "$HOME/.local/bin/$s" ./bin/
done

# Custom user units only — enable-state symlinks (*.wants) stay out
mkdir -p ./systemd/user
cp -f "$HOME"/.config/systemd/user/*.service "$HOME"/.config/systemd/user/*.path ./systemd/user/

# Package + service reality
pacman -Qqen > pkglist-native.txt
pacman -Qqem > pkglist-aur.txt
{
  echo "# Enabled units on miskatonic. Regenerated by ./import_current — do not hand-edit."
  echo "# Apply on a fresh install: systemctl enable <unit> / systemctl --user enable <unit>"
  echo
  echo "# system"
  systemctl list-unit-files --state=enabled --no-legend | awk '{print $1}' | grep -v '@'
  echo
  echo "# user"
  systemctl --user list-unit-files --state=enabled --no-legend | awk '{print $1}'
} > services.txt
