#!/bin/sh
# Pull the live state of yuggoth into this repo. Run from the repo root.
set -eu

dirs="ghostty nvim opencode tmux zsh starship lazygit btop git karabiner"
scripts="review unreview secrets-pull"

for d in $dirs; do
  rm -rf "./$d"
  cp -r "$HOME/.config/$d" ./
done

# Until ~/.gitconfig moves to the XDG path, it is the authoritative git config
[ -f "$HOME/.gitconfig" ] && cp -f "$HOME/.gitconfig" ./git/config

# Strip machine state that must never be committed
rm -f ./zsh/.zsh_history ./zsh/.zcompdump* ./zsh/.secrets.env
rm -rf ./tmux/plugins ./nvim/doc ./opencode/node_modules
rm -rf ./karabiner/automatic_backups
find . -name .DS_Store -delete

mkdir -p ./bin
for s in $scripts; do
  cp -f "$HOME/.local/bin/$s" ./bin/
done

# Package reality
brew bundle dump --force --file=Brewfile
