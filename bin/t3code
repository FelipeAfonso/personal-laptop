#!/usr/bin/env bash
# Launch the newest T3 Code AppImage with a working keyring backend.
# Chromium can't auto-detect a password store on Hyprland and falls back to
# basic_text, which makes Clerk auth tokens unstorable ("You are signed out").
set -euo pipefail

appimage="$(ls -t "$HOME"/Applications/T3-Code-*.AppImage 2>/dev/null | head -n1)"
if [[ -z "${appimage}" ]]; then
  notify-send "T3 Code" "No T3-Code AppImage found in ~/Applications" 2>/dev/null || true
  echo "No T3-Code AppImage found in ~/Applications" >&2
  exit 1
fi

exec "${appimage}" --no-sandbox --password-store=kwallet6 "$@"
