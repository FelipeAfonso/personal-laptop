#!/bin/sh
# secrets-pull — decrypt yuggoth.yaml from the private secrets repo into
# ~/.config/zsh/.secrets.env (sourced by .zshrc, gitignored). Needs sops and
# the personal age key at ~/.config/sops/age/keys.txt.
set -eu

repo="${SECRETS_REPO:-$HOME/code/personal/secrets}"
out="${ZDOTDIR:-$HOME/.config/zsh}/.secrets.env"

if [ ! -f "$repo/yuggoth.yaml" ]; then
  echo "missing $repo/yuggoth.yaml — clone git@github.com:FelipeAfonso/secrets.git first" >&2
  exit 1
fi

umask 077
sops -d --input-type yaml --output-type dotenv "$repo/yuggoth.yaml" > "$out"
echo "wrote $out ($(grep -c '=' "$out") keys)"
