/* Rofi theme — auto-generated by wallust, do not edit manually */

* {
    background:     #2B2826;
    foreground:     #FFF7CD;
    color0:         #585351;
    color1:         #7F9990;
    color2:         #8F94AE;
    color3:         #8AA592;
    color4:         #BF9F63;
    color5:         #A1B0A2;
    color6:         #BFAE55;
    color7:         #F6EBB0;
    color8:         #ACA57B;
    color9:         #A0C6B8;
    color10:        #BFC5E8;
    color11:        #B9DCC3;
    color12:        #FFD584;
    color13:        #D6EBD8;
    color14:        #FEE971;
    color15:        #F6EBB0;
}

window {
    width:              900px;
    border:             3px;
    border-color:       @color4;
    border-radius:      12px;
    background-color:   @background;
    padding:            0;
}

mainbox {
    background-color:   transparent;
    children:           [ inputbar, listview ];
}

inputbar {
    background-color:   @color0;
    border-radius:      12px 12px 0 0;
    padding:            12px;
    spacing:            8px;
    children:           [ prompt, entry ];
}

prompt {
    background-color:   transparent;
    text-color:         @color4;
    font:               "Geist Mono Bold 36";
}

entry {
    background-color:   transparent;
    text-color:         @foreground;
    placeholder:        "Search...";
    placeholder-color:  @color8;
    font:               "Geist Mono 36";
}

listview {
    background-color:   transparent;
    columns:            1;
    lines:              8;
    padding:            8px 0;
    fixed-height:       false;
    border:             0;
    scrollbar:          false;
}

element {
    background-color:   transparent;
    text-color:         @foreground;
    padding:            8px 12px;
    spacing:            12px;
    border-radius:      0;
}

element selected {
    background-color:   @color8;
    text-color:         @foreground;
    border-radius:      6px;
}

element-icon {
    size:               48px;
    background-color:   transparent;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    font:               "Geist Mono 36";
    vertical-align:     0.5;
}
