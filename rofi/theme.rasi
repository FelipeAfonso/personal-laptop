/* Rofi theme — auto-generated by wallust, do not edit manually */

* {
    background:     #141213;
    foreground:     #E8E3D8;
    color0:         #3F3D3D;
    color1:         #535B51;
    color2:         #5C7060;
    color3:         #797D63;
    color4:         #73807F;
    color5:         #977C54;
    color6:         #8E836C;
    color7:         #D6CFBF;
    color8:         #969186;
    color9:         #5B6759;
    color10:        #67826D;
    color11:        #7C8159;
    color12:        #849897;
    color13:        #BB9357;
    color14:        #BEAF90;
    color15:        #D6CFBF;
}

window {
    width:              900px;
    border:             3px;
    border-color:       @color4;
    border-radius:      12px;
    background-color:   @background;
    padding:            0;
}

mainbox {
    background-color:   transparent;
    children:           [ inputbar, listview ];
}

inputbar {
    background-color:   @color0;
    border-radius:      12px 12px 0 0;
    padding:            12px;
    spacing:            8px;
    children:           [ prompt, entry ];
}

prompt {
    background-color:   transparent;
    text-color:         @color4;
    font:               "Geist Mono Bold 36";
}

entry {
    background-color:   transparent;
    text-color:         @foreground;
    placeholder:        "Search...";
    placeholder-color:  @color8;
    font:               "Geist Mono 36";
}

listview {
    background-color:   transparent;
    columns:            1;
    lines:              8;
    padding:            8px 0;
    fixed-height:       false;
    border:             0;
    scrollbar:          false;
}

element {
    background-color:   transparent;
    text-color:         @foreground;
    padding:            8px 12px;
    spacing:            12px;
    border-radius:      0;
}

element selected {
    background-color:   @color8;
    text-color:         @foreground;
    border-radius:      6px;
}

element-icon {
    size:               48px;
    background-color:   transparent;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    font:               "Geist Mono 36";
    vertical-align:     0.5;
}
