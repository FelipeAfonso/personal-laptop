/* Rofi theme — auto-generated by wallust, do not edit manually */

* {
    background:     #0E1012;
    foreground:     #E6EDF5;
    color0:         #383A3C;
    color1:         #3D454A;
    color2:         #42484F;
    color3:         #5A697C;
    color4:         #72808E;
    color5:         #7F91A3;
    color6:         #8999AA;
    color7:         #D2DDE9;
    color8:         #939BA3;
    color9:         #3E4950;
    color10:        #444C56;
    color11:        #647993;
    color12:        #6A7F96;
    color13:        #A9C2DA;
    color14:        #B6CCE3;
    color15:        #D2DDE9;
}

window {
    width:              900px;
    border:             3px;
    border-color:       @color4;
    border-radius:      12px;
    background-color:   @background;
    padding:            0;
}

mainbox {
    background-color:   transparent;
    children:           [ inputbar, listview ];
}

inputbar {
    background-color:   @color0;
    border-radius:      12px 12px 0 0;
    padding:            12px;
    spacing:            8px;
    children:           [ prompt, entry ];
}

prompt {
    background-color:   transparent;
    text-color:         @color4;
    font:               "Geist Mono Bold 36";
}

entry {
    background-color:   transparent;
    text-color:         @foreground;
    placeholder:        "Search...";
    placeholder-color:  @color8;
    font:               "Geist Mono 36";
}

listview {
    background-color:   transparent;
    columns:            1;
    lines:              8;
    padding:            8px 0;
    fixed-height:       false;
    border:             0;
    scrollbar:          false;
}

element {
    background-color:   transparent;
    text-color:         @foreground;
    padding:            8px 12px;
    spacing:            12px;
    border-radius:      0;
}

element selected {
    background-color:   @color8;
    text-color:         @foreground;
    border-radius:      6px;
}

element-icon {
    size:               48px;
    background-color:   transparent;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    font:               "Geist Mono 36";
    vertical-align:     0.5;
}
